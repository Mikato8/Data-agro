# Despliegue en Hostinger cuando el documento raíz es public_html y no se
# puede apuntar directamente a /public. Redirige todo a public/ y bloquea
# directorios sensibles. Si el documento raíz ya apunta a public/, este
# archivo no se usa.
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteRule ^(app|config|database|storage|bin|tests|vendor)(/|$) - [F,L]
    RewriteRule ^\.env - [F,L]
    RewriteRule ^(composer\.(json|lock)|README\.md|LICENSE|\.git)(/|$) - [F,L]

    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>
