# ---------------------------------------------------------------------------
# AgroDiagnóstico · ejemplo de configuración
# Copia este archivo como .env y completa los valores.
# Nunca subas .env al repositorio.
# ---------------------------------------------------------------------------

APP_NAME="AgroDiagnóstico"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://tu-dominio.mx
APP_TIMEZONE=America/Mexico_City
APP_LOCALE=es_MX
APP_KEY=

# Neon PostgreSQL
# Usa la conexión directa (sin -pooler) para la aplicación y las migraciones.
# En Hostinger, el libpq antiguo necesita además el parámetro options con el
# endpoint, por ejemplo:
#   ...neondb?sslmode=require&channel_binding=require&options=endpoint%3Dep-xxxx
DATABASE_URL="postgresql://USUARIO:CONTRASENA@HOST-DIRECTO/neondb?sslmode=require&channel_binding=require"
DATABASE_URL_UNPOOLED="postgresql://USUARIO:CONTRASENA@HOST-DIRECTO/neondb?sslmode=require&channel_binding=require"

# auto: usa pdo_pgsql si está disponible y, si no, el endpoint HTTPS de Neon.
# pdo: fuerza la conexión TCP (recomendado cuando pdo_pgsql está disponible).
# http: sólo si el hosting no permite PostgreSQL por TCP.
DB_DRIVER=pdo

# Sesiones
SESSION_NAME=agro_session
SESSION_LIFETIME=7200
SESSION_SECURE=true

# Imágenes
UPLOAD_MAX_BYTES=5242880
UPLOAD_MAX_FILES=6

# Verificación de cédula profesional (API Market / SEP)
# Se activa sólo cuando tengas token y quieras validar automáticamente.
CEDULA_VALIDATION_ENABLED=false
CEDULA_API_URL=https://apimarket.mx/api/sep/grupo/validar-cedula
CEDULA_API_TOKEN=
CEDULA_API_TIMEOUT=15

# Clasificador de riesgo fitosanitario (servicio FastAPI aparte)
# Si se deja vacío, la sección de IA muestra que no está configurada.
AI_SERVICE_URL=
AI_SERVICE_TOKEN=

# Correo transaccional (recuperación de contraseña)
MAIL_ENABLED=false
MAIL_FROM=no-reply@tu-dominio.mx
MAIL_FROM_NAME="AgroDiagnóstico"

# Verificación automática de cuentas (solo para desarrollo)
AUTO_VERIFY_USERS=false
