# ---------------------------------------------------------------------------
# Diagnóstico Veterinario · ejemplo de configuración
# Copia este archivo como .env y completa los valores.
# Nunca subas .env al repositorio.
# ---------------------------------------------------------------------------

APP_NAME="Diagnóstico Veterinario"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://tu-dominio.mx
APP_TIMEZONE=America/Mexico_City
APP_LOCALE=es_MX
APP_KEY=

# Neon PostgreSQL
# Para la aplicación se recomienda la URL agrupada (pooler).
DATABASE_URL="postgresql://USUARIO:CONTRASENA@HOST-POOLER/neondb?sslmode=require&channel_binding=require"
# URL directa (sin -pooler), necesaria para migraciones y mantenimiento.
DATABASE_URL_UNPOOLED="postgresql://USUARIO:CONTRASENA@HOST/neondb?sslmode=require&channel_binding=require"

# auto: usa pdo_pgsql si está disponible y, si no, el endpoint HTTPS de Neon.
# http: recomendado en hostings compartidos sin pdo_pgsql.
# pdo: fuerza la conexión TCP.
DB_DRIVER=http

# Sesiones
SESSION_NAME=dv_session
SESSION_LIFETIME=7200
SESSION_SECURE=true

# Imágenes
UPLOAD_MAX_BYTES=5242880
UPLOAD_MAX_FILES=6

# Verificación de cédula profesional (API Market / SEP)
# Se activa sólo cuando tengas token y quieras validar automáticamente.
CEDULA_VALIDATION_ENABLED=false
CEDULA_API_URL=https://apimarket.mx/api/sep/grupo/validar-cedula
CEDULA_API_TOKEN=
CEDULA_API_TIMEOUT=15

# IA de urgencia (SetFit + ONNX en Hugging Face Space)
# Si se deja vacío, la sección de IA muestra que no está configurada.
AI_SERVICE_URL=https://tu-space.hf.space
AI_SERVICE_TOKEN=

# Correo transaccional (recuperación de contraseña)
MAIL_ENABLED=false
MAIL_FROM=no-reply@tu-dominio.mx
MAIL_FROM_NAME="Diagnóstico Veterinario"

# Verificación automática de cuentas (solo para desarrollo)
AUTO_VERIFY_USERS=false
